{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wenyu0608/token-saver/schema/token-receipt.schema.json",
  "title": "Token Saver Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "methods", "measurement", "reason"],
  "properties": {
    "version": { "enum": ["1.0", "1.1"] },
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "measurement": { "enum": ["exact", "estimated", "observed-only"] },
    "baseline_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "optimized_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "optimizer_overhead_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "net_saved_tokens": { "type": ["integer", "null"] },
    "saved_percent": { "type": ["number", "null"] },
    "baseline_image_pages": { "type": ["integer", "null"], "minimum": 0 },
    "optimized_image_pages": { "type": ["integer", "null"], "minimum": 0 },
    "image_pages_saved": { "type": ["integer", "null"] },
    "image_pages_saved_percent": { "type": ["number", "null"] },
    "fidelity_mode": { "enum": ["focused", "full"] },
    "evidence_retained": { "type": "boolean" },
    "cached_tokens_affected": { "type": ["integer", "null"], "minimum": 0 },
    "observable_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "attributable_saved_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "reason": { "type": "string", "minLength": 1 },
    "quality_fallback_used": { "type": "boolean", "default": false }
  },
  "allOf": [
    {
      "if": { "properties": { "measurement": { "const": "observed-only" } } },
      "then": {
        "required": ["observable_input_tokens", "attributable_saved_tokens"],
        "properties": {
          "baseline_input_tokens": { "type": "null" },
          "net_saved_tokens": { "type": "null" }
        }
      }
    }
  ]
}
